#!/bin/sh
# Runs inside the cage compositor: set the saved display mode, then start the
# kiosk browser on Home Base home screen.
echo "$WAYLAND_DISPLAY" > "$XDG_RUNTIME_DIR/homebase-wayland"
/usr/bin/python3 /opt/homebase/backend/homebase.py apply-display
# The picture is (re)starting: ask the TV to show this input (HDMI-CEC), in case it left it while the signal was down
/opt/homebase/bin/homebase-cec-active &

# Wait for the backend (started by systemd) before loading the page.
i=0
while [ $i -lt 50 ] && ! curl -fs http://127.0.0.1:8099/api/session >/dev/null 2>&1; do
  sleep 0.2; i=$((i + 1))
done

PROFILE="$HOME/.config/homebase-chromium"
# Don't show "Chromium didn't shut down correctly" after a power cut.
if [ -f "$PROFILE/Default/Preferences" ]; then
  sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"Crashed"/"exit_type":"Normal"/' "$PROFILE/Default/Preferences"
fi

BROWSER=$(command -v chromium || command -v chromium-browser)
exec "$BROWSER" \
  --kiosk --noerrdialogs --disable-infobars --no-first-run --no-default-browser-check \
  --ozone-platform=wayland \
  --autoplay-policy=no-user-gesture-required \
  --disable-features=Translate,DisableLoadExtensionCommandLineSwitch,HardwareMediaKeyHandling \
  --password-store=basic \
  --check-for-update-interval=31536000 \
  --user-data-dir="$PROFILE" \
  --load-extension=/opt/homebase/chromium-ext \
  http://127.0.0.1:8099/
