# pi-gen configuration for the Home Base image.
IMG_NAME=homebase
PI_GEN_RELEASE="Home Base"
RELEASE=trixie
TARGET_HOSTNAME=homebase
FIRST_USER_NAME=homebase
# FIRST_USER_PASS is generated by build.sh and the account is locked again in
# stage-homebase; the image ships with no usable password.
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
ENABLE_CLOUD_INIT=0
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=Etc/UTC
STAGE_LIST="stage0 stage1 stage2 stage-homebase"
DEPLOY_COMPRESSION=xz
